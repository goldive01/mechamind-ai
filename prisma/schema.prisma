generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Equipment {
  id                 String              @id @default(cuid())
  name               String
  manufacturer       String
  model              String
  serialNumber       String              @unique
  category           String
  description        String?
  location           String?
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inspections        Inspection[]
  maintenanceRecords MaintenanceRecord[]
  sensorDevices      SensorDevice[]
  asset              Asset?
}

model Asset {
  id            String         @id @default(cuid())
  assetId       String         @unique
  equipmentId   String         @unique
  equipment     Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  status        String         @default("Active")
  primaryImage  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  inspections   Inspection[]
  aiReports     AIReport[]
  sensorDevices SensorDevice[]
  alerts        Alert[]
}

model Alert {
  id              String         @id @default(cuid())
  assetId         String         @map("assetDbId")
  asset           Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fingerprint     String         @unique
  severity        String
  category        String         @default("Engineering")
  status          String         @default("Open")
  source          String
  metric          String
  title           String
  description     String         @default("") @map("explanation")
  recommendation  String
  triggerType     String?
  triggerId       String?
  observedValue   Float?
  thresholdValue  Float?
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
  resolvedAt      DateTime?
  resolvedBy      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  history         AlertHistory[]

  @@index([status, severity, updatedAt])
  @@index([assetId, updatedAt])
}

model AlertHistory {
  id        String   @id @default(cuid())
  alertId   String
  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  eventType String
  fromValue String?
  toValue   String?
  actor     String?
  note      String?
  createdAt DateTime @default(now())

  @@index([alertId, createdAt])
}

model AssetSequence {
  id    String @id
  value Int    @default(0)
}

model Inspection {
  id               String            @id @default(cuid())
  equipmentId      String
  equipment        Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  assetId          String
  asset            Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  overallCondition String
  notes            String?
  inspectionDate   DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  images           InspectionImage[]
  aiReport         AIReport?
}

model InspectionImage {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  imagePath    String
}

model MaintenanceRecord {
  id              String    @id @default(cuid())
  equipmentId     String
  equipment       Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  maintenanceType String
  performedBy     String
  notes           String?
  maintenanceDate DateTime  @default(now())
}

model SensorDevice {
  id              String          @id @default(cuid())
  equipmentId     String
  equipment       Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  assetId         String
  asset           Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  deviceName      String
  sensorType      String
  macAddress      String          @unique
  firmwareVersion String
  lastSeen        DateTime?       @default(now())
  readings        SensorReading[]
}

model SensorReading {
  id             String       @id @default(cuid())
  sensorDeviceId String
  sensorDevice   SensorDevice @relation(fields: [sensorDeviceId], references: [id], onDelete: Cascade)
  temperature    Float?
  humidity       Float?
  vibration      Float?
  voltage        Float?
  current        Float?
  recordedAt     DateTime     @default(now())
}

model AIReport {
  id              String     @id @default(cuid())
  inspectionId    String     @unique
  inspection      Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  assetId         String
  asset           Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  diagnosis       String
  recommendations String
  riskLevel       String
  createdAt       DateTime   @default(now())
}

model CopilotConversation {
  id        String                   @id @default(cuid())
  title     String                   @default("Engineering conversation")
  assetIds  String                   @default("[]")
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  messages  CopilotConversationMessage[]
}

model CopilotConversationMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  responseJson   String?
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}
