generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String       @id @default(cuid())
  fullName     String
  email        String       @unique
  passwordHash String       @default("")
  active       Boolean      @default(true)
  roleId       String?
  role         Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  sessions     Session[]
  auditLogs    AuditLog[]
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([roleId, active])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
  memberships Membership[]
}

model Organisation {
  id                  String                @id @default(cuid())
  slug                String                @unique
  name                String
  description         String?
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  sites               Site[]
  memberships         Membership[]
  equipment           Equipment[]
  assets              Asset[]
  conversations       CopilotConversation[]
  engineeringMemories EngineeringMemory[]

  @@index([active, name])
}

model EngineeringMemory {
  id              String               @id @default(cuid())
  organisationId  String
  organisation    Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sourceType      String
  sourceId        String
  externalKey     String
  title           String
  summary         String
  detailsJson     String               @default("{}")
  equipmentId     String?
  assetId         String?
  fault           String?
  engineerId      String?
  partId          String?
  sensorId        String?
  alertId         String?
  timelineType    String?
  confidence      Float                @default(0.7)
  successful      Boolean?
  occurrenceCount Int                  @default(1)
  occurredAt      DateTime
  lastObservedAt  DateTime
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  events          MemoryEvent[]
  tags            MemoryTag[]
  outgoing        MemoryRelationship[] @relation("MemoryRelationshipFrom")
  incoming        MemoryRelationship[] @relation("MemoryRelationshipTo")

  @@unique([organisationId, externalKey])
  @@index([organisationId, assetId, occurredAt])
  @@index([organisationId, sourceType, occurredAt])
  @@index([organisationId, engineerId, partId, sensorId])
}

model MemoryEvent {
  id          String            @id @default(cuid())
  memoryId    String
  memory      EngineeringMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  eventType   String
  sourceType  String
  sourceId    String
  payloadJson String            @default("{}")
  occurredAt  DateTime
  createdAt   DateTime          @default(now())

  @@index([memoryId, occurredAt])
  @@index([sourceType, sourceId])
}

model MemoryRelationship {
  id           String            @id @default(cuid())
  fromMemoryId String
  toMemoryId   String
  relationship String
  strength     Float             @default(1)
  createdAt    DateTime          @default(now())
  fromMemory   EngineeringMemory @relation("MemoryRelationshipFrom", fields: [fromMemoryId], references: [id], onDelete: Cascade)
  toMemory     EngineeringMemory @relation("MemoryRelationshipTo", fields: [toMemoryId], references: [id], onDelete: Cascade)

  @@unique([fromMemoryId, toMemoryId, relationship])
  @@index([toMemoryId, relationship])
}

model MemoryTag {
  id        String            @id @default(cuid())
  memoryId  String
  memory    EngineeringMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  name      String
  value     String?
  createdAt DateTime          @default(now())

  @@unique([memoryId, name, value])
  @@index([name, value])
}

model Site {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  address        String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  buildings      Building[]
  equipment      Equipment[]

  @@unique([organisationId, code])
  @@index([organisationId, active, name])
}

model Building {
  id        String      @id @default(cuid())
  siteId    String
  site      Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  code      String
  name      String
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  areas     Area[]
  equipment Equipment[]

  @@unique([siteId, code])
  @@index([siteId, active, name])
}

model Area {
  id          String      @id @default(cuid())
  buildingId  String
  building    Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  equipment   Equipment[]

  @@unique([buildingId, code])
  @@index([buildingId, active, name])
}

model Membership {
  id             String       @id @default(cuid())
  organisationId String
  userId         String
  roleId         String?
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, userId])
  @@index([userId, active])
  @@index([organisationId, roleId, active])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  resource     String
  resourceId   String?
  outcome      String   @default("SUCCESS")
  metadataJson String   @default("{}")
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([resource, resourceId, createdAt])
}

model Equipment {
  id                 String              @id @default(cuid())
  name               String
  manufacturer       String
  model              String
  serialNumber       String              @unique
  category           String
  description        String?
  location           String?
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inspections        Inspection[]
  maintenanceRecords MaintenanceRecord[]
  sensorDevices      SensorDevice[]
  asset              Asset?
  organisationId     String              @default("legacy")
  organisation       Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  siteId             String?
  site               Site?               @relation(fields: [siteId], references: [id], onDelete: SetNull)
  buildingId         String?
  building           Building?           @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  areaId             String?
  area               Area?               @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@unique([organisationId, serialNumber])
  @@index([organisationId, siteId, buildingId, areaId])
}

model Asset {
  id             String          @id @default(cuid())
  assetId        String          @unique
  equipmentId    String          @unique
  equipment      Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  status         String          @default("Active")
  primaryImage   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inspections    Inspection[]
  aiReports      AIReport[]
  sensorDevices  SensorDevice[]
  alerts         Alert[]
  workOrders     WorkOrder[]
  stockMovements StockMovement[]
  organisationId String          @default("legacy")
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, assetId])
  @@index([organisationId, status])
}

model WorkOrder {
  id                 String              @id @default(cuid())
  assetId            String
  asset              Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title              String
  description        String
  priority           String              @default("Medium")
  status             String              @default("Draft")
  assignedTo         String?
  assignedEngineerId String?
  assignedEngineer   Engineer?           @relation(fields: [assignedEngineerId], references: [id], onDelete: SetNull)
  teamId             String?
  team               Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  scheduledStart     DateTime?
  dueDate            DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  signatures         DigitalSignature[]
  evidence           WorkOrderEvidence[]
  parts              WorkOrderPart[]

  @@index([status, priority, scheduledStart])
  @@index([assetId, updatedAt])
  @@index([assignedTo, status])
  @@index([assignedEngineerId, status])
  @@index([teamId, status])
}

model Warehouse {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  description    String?
  location       String?
  manager        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventoryItems InventoryItem[]
}

model Supplier {
  id                String      @id @default(cuid())
  supplierCode      String      @unique
  name              String
  email             String?
  phone             String?
  website           String?
  address           String?
  leadTimeDays      Int         @default(0)
  preferredSupplier Boolean     @default(false)
  rating            Float       @default(0)
  createdAt         DateTime    @default(now())
  spareParts        SparePart[]
}

model SparePart {
  id                   String          @id @default(cuid())
  partNumber           String          @unique
  barcode              String?         @unique
  qrCode               String?         @unique
  name                 String
  description          String?
  manufacturer         String?
  category             String
  image                String?
  compatibleAssetTypes String          @default("[]")
  unitCost             Float           @default(0)
  reorderLevel         Int             @default(0)
  minimumStock         Int             @default(0)
  maximumStock         Int             @default(0)
  leadTimeDays         Int             @default(0)
  supplierId           String?
  supplier             Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  inventoryItems       InventoryItem[]

  @@index([category, name])
  @@index([supplierId])
}

model InventoryItem {
  id             String          @id @default(cuid())
  warehouseId    String
  sparePartId    String
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  sparePart      SparePart       @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  quantity       Int             @default(0)
  reserved       Int             @default(0)
  available      Int             @default(0)
  shelf          String?
  lastMovementAt DateTime?
  movements      StockMovement[]
  workOrderParts WorkOrderPart[]

  @@unique([warehouseId, sparePartId])
  @@index([sparePartId, quantity])
}

model WorkOrderPart {
  id              String        @id @default(cuid())
  workOrderId     String
  inventoryItemId String
  quantity        Int
  deductedAt      DateTime?
  workOrder       WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([workOrderId, inventoryItemId])
  @@index([workOrderId, deductedAt])
}

model StockMovement {
  id                         String        @id @default(cuid())
  inventoryItemId            String
  destinationInventoryItemId String?
  assetId                    String?
  workOrderId                String?
  movementType               String
  quantity                   Int
  balanceAfter               Int
  performedBy                String
  reference                  String?
  notes                      String?
  createdAt                  DateTime      @default(now())
  inventoryItem              InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  asset                      Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, createdAt])
  @@index([workOrderId, createdAt])
  @@index([assetId, createdAt])
}

model Engineer {
  id                      String                 @id @default(cuid())
  employeeNumber          String                 @unique
  name                    String
  email                   String                 @unique
  active                  Boolean                @default(true)
  maxConcurrentWorkOrders Int                    @default(5)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  skills                  EngineerSkill[]
  certifications          Certification[]
  availability            EngineerAvailability[]
  teams                   TeamMembership[]
  workOrders              WorkOrder[]
}

model Team {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  members     TeamMembership[]
  workOrders  WorkOrder[]
}

model Skill {
  id        String          @id @default(cuid())
  name      String          @unique
  category  String
  createdAt DateTime        @default(now())
  engineers EngineerSkill[]
}

model EngineerSkill {
  engineerId      String
  skillId         String
  proficiency     Int      @default(1)
  yearsExperience Float    @default(0)
  engineer        Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  skill           Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([engineerId, skillId])
  @@index([skillId, proficiency])
}

model Certification {
  id             String    @id @default(cuid())
  engineerId     String
  engineer       Engineer  @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  name           String
  issuer         String
  credentialCode String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([engineerId, expiresAt])
}

model EngineerAvailability {
  id         String   @id @default(cuid())
  engineerId String
  engineer   Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  status     String   @default("Available")
  note       String?

  @@index([engineerId, startsAt, endsAt])
  @@index([status, startsAt, endsAt])
}

model TeamMembership {
  teamId     String
  engineerId String
  role       String   @default("Member")
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  engineer   Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@id([teamId, engineerId])
  @@index([engineerId])
}

model DigitalSignature {
  id            String    @id @default(cuid())
  workOrderId   String
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  signerName    String
  signatureData String
  latitude      Float?
  longitude     Float?
  signedAt      DateTime  @default(now())

  @@index([workOrderId, signedAt])
}

model WorkOrderEvidence {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  type        String
  uri         String?
  note        String?
  latitude    Float?
  longitude   Float?
  capturedAt  DateTime  @default(now())

  @@index([workOrderId, capturedAt])
}

model SyncQueueItem {
  id            String    @id
  entity        String
  entityId      String
  action        String
  payloadJson   String
  baseVersion   String?
  status        String    @default("Pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  conflictJson  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  syncedAt      DateTime?

  @@index([status, nextAttemptAt])
  @@index([entity, entityId, createdAt])
}

model Alert {
  id             String         @id @default(cuid())
  assetId        String         @map("assetDbId")
  asset          Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fingerprint    String         @unique
  severity       String
  category       String         @default("Engineering")
  status         String         @default("Open")
  source         String
  metric         String
  title          String
  description    String         @default("") @map("explanation")
  recommendation String
  triggerType    String?
  triggerId      String?
  observedValue  Float?
  thresholdValue Float?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  history        AlertHistory[]

  @@index([status, severity, updatedAt])
  @@index([assetId, updatedAt])
  @@index([category, source, createdAt])
}

model AlertHistory {
  id        String   @id @default(cuid())
  alertId   String
  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  eventType String
  fromValue String?
  toValue   String?
  actor     String?
  note      String?
  createdAt DateTime @default(now())

  @@index([alertId, createdAt])
}

model AssetSequence {
  id    String @id
  value Int    @default(0)
}

model Inspection {
  id               String            @id @default(cuid())
  equipmentId      String
  equipment        Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  assetId          String
  asset            Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  overallCondition String
  notes            String?
  inspectionDate   DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  images           InspectionImage[]
  aiReport         AIReport?
}

model InspectionImage {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  imagePath    String
}

model MaintenanceRecord {
  id              String    @id @default(cuid())
  equipmentId     String
  equipment       Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  maintenanceType String
  performedBy     String
  notes           String?
  maintenanceDate DateTime  @default(now())
}

model SensorDevice {
  id              String          @id @default(cuid())
  equipmentId     String
  equipment       Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  assetId         String
  asset           Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  deviceName      String
  sensorType      String
  macAddress      String          @unique
  firmwareVersion String
  lastSeen        DateTime?       @default(now())
  readings        SensorReading[]
}

model SensorReading {
  id             String       @id @default(cuid())
  sensorDeviceId String
  sensorDevice   SensorDevice @relation(fields: [sensorDeviceId], references: [id], onDelete: Cascade)
  temperature    Float?
  humidity       Float?
  vibration      Float?
  voltage        Float?
  current        Float?
  recordedAt     DateTime     @default(now())
}

model AIReport {
  id              String     @id @default(cuid())
  inspectionId    String     @unique
  inspection      Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  assetId         String
  asset           Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  diagnosis       String
  recommendations String
  riskLevel       String
  createdAt       DateTime   @default(now())
}

model CopilotConversation {
  id             String                       @id @default(cuid())
  title          String                       @default("Engineering conversation")
  assetIds       String                       @default("[]")
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  messages       CopilotConversationMessage[]
  organisationId String                       @default("legacy")
  organisation   Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, updatedAt])
}

model CopilotConversationMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  responseJson   String?
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}
