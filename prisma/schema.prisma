generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Equipment {
  id                 String              @id @default(cuid())
  name               String
  manufacturer       String
  model              String
  serialNumber       String              @unique
  category           String
  description        String?
  location           String?
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inspections        Inspection[]
  maintenanceRecords MaintenanceRecord[]
  sensorDevices      SensorDevice[]
  asset              Asset?
}

model Asset {
  id            String         @id @default(cuid())
  assetId       String         @unique
  equipmentId   String         @unique
  equipment     Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  status        String         @default("Active")
  primaryImage  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  inspections   Inspection[]
  aiReports     AIReport[]
  sensorDevices SensorDevice[]
  alerts        Alert[]
  workOrders    WorkOrder[]
  stockMovements StockMovement[]
}

model WorkOrder {
  id                 String              @id @default(cuid())
  assetId            String
  asset              Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title              String
  description        String
  priority           String              @default("Medium")
  status             String              @default("Draft")
  assignedTo         String?
  assignedEngineerId String?
  assignedEngineer   Engineer?           @relation(fields: [assignedEngineerId], references: [id], onDelete: SetNull)
  teamId             String?
  team               Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  scheduledStart     DateTime?
  dueDate            DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  signatures         DigitalSignature[]
  evidence           WorkOrderEvidence[]
  parts              WorkOrderPart[]

  @@index([status, priority, scheduledStart])
  @@index([assetId, updatedAt])
  @@index([assignedTo, status])
  @@index([assignedEngineerId, status])
  @@index([teamId, status])
}

model Warehouse {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  location       String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  workOrderParts WorkOrderPart[]
}

model Supplier {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  contactName String?
  email       String?
  phone       String?
  leadTimeDays Int        @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  spareParts  SparePart[]
}

model SparePart {
  id             String          @id @default(cuid())
  sku            String          @unique
  name           String
  description    String?
  category       String
  unit           String          @default("each")
  unitCost        Float           @default(0)
  reorderPoint   Int             @default(0)
  reorderQuantity Int            @default(1)
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  workOrderParts WorkOrderPart[]

  @@index([category, name])
  @@index([supplierId])
}

model InventoryItem {
  id          String    @id @default(cuid())
  warehouseId String
  sparePartId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  reserved    Int       @default(0)
  binLocation String?
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, sparePartId])
  @@index([sparePartId, quantity])
}

model WorkOrderPart {
  id          String    @id @default(cuid())
  workOrderId String
  sparePartId String
  warehouseId String
  quantity    Int
  deductedAt  DateTime?
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([workOrderId, sparePartId, warehouseId])
  @@index([workOrderId, deductedAt])
}

model StockMovement {
  id          String    @id @default(cuid())
  warehouseId String
  sparePartId String
  assetId     String?
  workOrderId String?
  type        String
  quantity    Int
  balanceAfter Int
  reason      String
  reference   String?
  createdAt   DateTime  @default(now())
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  asset       Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([warehouseId, sparePartId, createdAt])
  @@index([workOrderId, createdAt])
  @@index([assetId, createdAt])
}

model Engineer {
  id                      String                 @id @default(cuid())
  employeeNumber          String                 @unique
  name                    String
  email                   String                 @unique
  active                  Boolean                @default(true)
  maxConcurrentWorkOrders Int                    @default(5)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  skills                  EngineerSkill[]
  certifications          Certification[]
  availability            EngineerAvailability[]
  teams                   TeamMembership[]
  workOrders              WorkOrder[]
}

model Team {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  members     TeamMembership[]
  workOrders  WorkOrder[]
}

model Skill {
  id        String          @id @default(cuid())
  name      String          @unique
  category  String
  createdAt DateTime        @default(now())
  engineers EngineerSkill[]
}

model EngineerSkill {
  engineerId      String
  skillId         String
  proficiency     Int      @default(1)
  yearsExperience Float    @default(0)
  engineer        Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  skill           Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([engineerId, skillId])
  @@index([skillId, proficiency])
}

model Certification {
  id             String    @id @default(cuid())
  engineerId     String
  engineer       Engineer  @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  name           String
  issuer         String
  credentialCode String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([engineerId, expiresAt])
}

model EngineerAvailability {
  id         String   @id @default(cuid())
  engineerId String
  engineer   Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  status     String   @default("Available")
  note       String?

  @@index([engineerId, startsAt, endsAt])
  @@index([status, startsAt, endsAt])
}

model TeamMembership {
  teamId     String
  engineerId String
  role       String   @default("Member")
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  engineer   Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@id([teamId, engineerId])
  @@index([engineerId])
}

model DigitalSignature {
  id            String    @id @default(cuid())
  workOrderId   String
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  signerName    String
  signatureData String
  latitude      Float?
  longitude     Float?
  signedAt      DateTime  @default(now())

  @@index([workOrderId, signedAt])
}

model WorkOrderEvidence {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  type        String
  uri         String?
  note        String?
  latitude    Float?
  longitude   Float?
  capturedAt  DateTime  @default(now())

  @@index([workOrderId, capturedAt])
}

model SyncQueueItem {
  id            String    @id
  entity        String
  entityId      String
  action        String
  payloadJson   String
  baseVersion   String?
  status        String    @default("Pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  conflictJson  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  syncedAt      DateTime?

  @@index([status, nextAttemptAt])
  @@index([entity, entityId, createdAt])
}

model Alert {
  id             String         @id @default(cuid())
  assetId        String         @map("assetDbId")
  asset          Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fingerprint    String         @unique
  severity       String
  category       String         @default("Engineering")
  status         String         @default("Open")
  source         String
  metric         String
  title          String
  description    String         @default("") @map("explanation")
  recommendation String
  triggerType    String?
  triggerId      String?
  observedValue  Float?
  thresholdValue Float?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  history        AlertHistory[]

  @@index([status, severity, updatedAt])
  @@index([assetId, updatedAt])
  @@index([category, source, createdAt])
}

model AlertHistory {
  id        String   @id @default(cuid())
  alertId   String
  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  eventType String
  fromValue String?
  toValue   String?
  actor     String?
  note      String?
  createdAt DateTime @default(now())

  @@index([alertId, createdAt])
}

model AssetSequence {
  id    String @id
  value Int    @default(0)
}

model Inspection {
  id               String            @id @default(cuid())
  equipmentId      String
  equipment        Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  assetId          String
  asset            Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  overallCondition String
  notes            String?
  inspectionDate   DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  images           InspectionImage[]
  aiReport         AIReport?
}

model InspectionImage {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  imagePath    String
}

model MaintenanceRecord {
  id              String    @id @default(cuid())
  equipmentId     String
  equipment       Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  maintenanceType String
  performedBy     String
  notes           String?
  maintenanceDate DateTime  @default(now())
}

model SensorDevice {
  id              String          @id @default(cuid())
  equipmentId     String
  equipment       Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  assetId         String
  asset           Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  deviceName      String
  sensorType      String
  macAddress      String          @unique
  firmwareVersion String
  lastSeen        DateTime?       @default(now())
  readings        SensorReading[]
}

model SensorReading {
  id             String       @id @default(cuid())
  sensorDeviceId String
  sensorDevice   SensorDevice @relation(fields: [sensorDeviceId], references: [id], onDelete: Cascade)
  temperature    Float?
  humidity       Float?
  vibration      Float?
  voltage        Float?
  current        Float?
  recordedAt     DateTime     @default(now())
}

model AIReport {
  id              String     @id @default(cuid())
  inspectionId    String     @unique
  inspection      Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  assetId         String
  asset           Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  diagnosis       String
  recommendations String
  riskLevel       String
  createdAt       DateTime   @default(now())
}

model CopilotConversation {
  id        String                       @id @default(cuid())
  title     String                       @default("Engineering conversation")
  assetIds  String                       @default("[]")
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
  messages  CopilotConversationMessage[]
}

model CopilotConversationMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  responseJson   String?
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}
